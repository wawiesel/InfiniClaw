#!/bin/bash
# Guard bots/ and docs/ directory structure.
# Prevents commits that add files outside the expected layout.

errors=()
docs_errors=()

while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  # Allow top-level bots/ files
  case "$file" in
    bots/README.md|bots/CLAUDE.md) continue ;;
  esac

  # Allow bots/skills/ and bots/skills/{name}/...
  [[ "$file" =~ ^bots/skills/ ]] && continue

  # Allow bots/container/{bot}/...
  [[ "$file" =~ ^bots/container/[^/]+/ ]] && continue
  [[ "$file" == bots/container/build.sh ]] && continue
  [[ "$file" == bots/container/README.md ]] && continue

  # Allow bots/{role}/ROOM.md, skills.json, mcp.json
  [[ "$file" =~ ^bots/(navigator|engineer|architect)/(ROOM\.md|skills\.json|mcp\.json)$ ]] && continue

  # Allow bots/{role}/{bot}/{file} (one level deep only)
  [[ "$file" =~ ^bots/(navigator|engineer|architect)/[^/]+/[^/]+$ ]] && continue

  # Anything else under bots/ is wrong
  if [[ "$file" == bots/* ]]; then
    errors+=("$file")
  fi

  # docs/ — fixed file list
  if [[ "$file" == docs/* ]]; then
    case "$file" in
      docs/LESSONS_LEARNED.md|docs/SETUP.md|docs/assets/*|docs/faq/*|docs/design/*|docs/beacon/*) ;;
      *) docs_errors+=("$file") ;;
    esac
  fi
done < <(git diff --cached --name-only --diff-filter=ACR)

if [[ ${#errors[@]} -gt 0 ]]; then
  echo "ERROR: Files added outside expected bots/ structure:"
  echo ""
  echo "  Expected layout:"
  echo "    bots/{role}/ROOM.md"
  echo "    bots/{role}/{bot}/{file}"
  echo "    bots/skills/{name}/..."
  echo "    bots/container/{bot}/..."
  echo ""
  echo "  Rejected:"
  for f in "${errors[@]}"; do
    echo "    $f"
  done
  echo ""
  echo "  If this is intentional, commit with --no-verify."
  exit 1
fi

if [[ ${#docs_errors[@]} -gt 0 ]]; then
  echo "ERROR: New files added to docs/ outside the fixed set:"
  echo ""
  echo "  Allowed: LESSONS_LEARNED.md, SETUP.md, assets/*, faq/*, design/*, beacon/*"
  echo ""
  echo "  Rejected:"
  for f in "${docs_errors[@]}"; do
    echo "    $f"
  done
  echo ""
  echo "  If this is intentional, commit with --no-verify."
  exit 1
fi
