{
  "name": "infiniclaw",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "external/nanoclaw"
  ],
  "scripts": {
    "build": "npm install --ignore-scripts 2>/dev/null; npm run build -w nanoclaw; npx tsc",
    "dev": "npm run build -w nanoclaw && tsc --watch",
    "cli": "node dist/cli.js",
    "test": "vitest run --root .",
    "test:watch": "vitest --root ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "better-sqlite3": "^12.8.0",
    "marked": "^17.0.3",
    "matrix-bot-sdk": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pm2": "^6.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
