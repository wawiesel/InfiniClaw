#!/usr/bin/env bash
# infiniclaw-managed
# Pre-commit rules: blocked paths and role-based restrictions.
set -euo pipefail

staged=$(git diff --cached --name-only)

# ── WBS 12.6: Single version source — sync package.json from SEMVER_VERSION ──
if echo "$staged" | grep -qF 'SEMVER_VERSION'; then
  semver=$(cat SEMVER_VERSION | tr -d '[:space:]')
  # Strip leading 'v' for package.json
  pkg_ver="${semver#v}"
  if [[ -n "$pkg_ver" ]]; then
    # Update package.json version in-place
    sed -i "s/\"version\": \"[^\"]*\"/\"version\": \"$pkg_ver\"/" package.json
    git add package.json
  fi
fi

# ── Blocked for everyone ──

if echo "$staged" | grep -q '^dist/'; then
  echo "ERROR: dist/ files staged for commit. Remove them with:"
  echo "  git reset HEAD dist/"
  exit 1
fi

if echo "$staged" | grep -q 'node_modules/'; then
  echo "ERROR: node_modules/ files staged for commit."
  exit 1
fi

# ── README sibling rule ──
# Any change to a non-README sibling must include a change to the directory's README.md.

# Auto-stage sibling READMEs (WBS 12.3: relaxed from hard rejection)
readmes_to_stage=()
while IFS= read -r file; do
  dir=$(dirname "$file")
  base=$(basename "$file")
  [[ "$base" == "README.md" ]] && continue
  readme="$dir/README.md"
  readme="${readme#./}"
  [[ ! -f "$readme" ]] && continue
  if ! echo "$staged" | grep -qF "$readme"; then
    readmes_to_stage+=("$readme")
  fi
done <<< "$staged"

if [[ ${#readmes_to_stage[@]} -gt 0 ]]; then
  # Deduplicate
  declare -A seen_readmes
  for r in "${readmes_to_stage[@]}"; do
    [[ -n "${seen_readmes[$r]:-}" ]] && continue
    seen_readmes[$r]=1
    # Touch the README with an updated timestamp comment
    sed -i '/^<!-- auto-updated:/d' "$r"
    echo "<!-- auto-updated: $(date -u +%Y-%m-%dT%H:%M:%SZ) -->" >> "$r"
    git add "$r"
  done
fi

# ── Design docs must not reference source code ──
# Design documents describe behavior and architecture, not implementation.
# Source code references belong in src/README.md, which links back to design docs.

design_violations=()
while IFS= read -r file; do
  # Skip if not a design doc
  [[ "$file" != docs/design/*.md ]] && continue
  # Check full staged content for source code references
  if git show ":$file" 2>/dev/null | grep -qE '(^|\s|`)(src/|external/nanoclaw/src/)[A-Za-z]'; then
    design_violations+=("$file")
  fi
done <<< "$staged"

if [[ ${#design_violations[@]} -gt 0 ]]; then
  echo "ERROR: Design docs must not reference source code paths (src/, external/nanoclaw/src/)."
  echo "Move implementation references to src/README.md instead."
  printf "  %s\n" "${design_violations[@]}"
  exit 1
fi

# ── Role-based restrictions (ASSISTANT_ROLE set inside containers) ──

role="${ASSISTANT_ROLE:-}"

if [[ "$role" == "engineer" ]]; then
  if echo "$staged" | grep -q '^docs/design/'; then
    echo "ERROR: engineers cannot modify docs/design/"
    exit 1
  fi
  if echo "$staged" | grep -q '^external/'; then
    if [[ "${IsChief:-}" != "true" ]]; then
      echo "ERROR: only the Chief engineer can modify external/"
      exit 1
    fi
  fi
fi
